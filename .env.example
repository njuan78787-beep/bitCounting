# =============================================================================
# Bit-Counting — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Full connection URL.  Both "postgres://" and "postgresql://" are accepted;
# the app converts to "postgresql+asyncpg://" internally.
DATABASE_URL=postgresql://postgres:[PASSWORD]@localhost:5432/bitcounting

# Supabase-specific variables (used when DATABASE_URL points to Supabase cloud)
SUPABASE_HOST=db.chaedywpozkqiabnwbwy.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=[PASSWORD]

# Docker Compose local dev overrides (used by docker-compose.yml)
POSTGRES_USER=bitcounting
POSTGRES_PASSWORD=bitcounting_dev_pass
POSTGRES_DB=bitcounting

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Used for token blacklist (logout) and rate limiting.
# Falls back to in-memory if not set (not suitable for multi-process prod).
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# JWT signing secret — must be ≥32 random characters in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=BIT-COUNTING-DEV-SECRET-CHANGE-IN-PRODUCTION-2026-MIN32CHARS

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins ADDED to the default localhost origins.
# Example for Vercel deployment:
# ALLOWED_ORIGINS=https://bit-counting.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
