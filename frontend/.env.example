# ─── Bit-Counting Frontend — Environment Variables ────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# ─── API Backend ──────────────────────────────────────────────────────────────
# Full URL of the Bit-Counting API backend (FastAPI).
# In development with Vite proxy, leave empty (proxied to localhost:8000).
# In production on Vercel, set this to your deployed backend URL.
#
# Example: https://bitcounting-api.onrender.com/api/v1
VITE_API_BASE_URL=

# ─── Demo / Preview Mode ──────────────────────────────────────────────────────
# Set to "true" to enable demo mode with mock data (no backend required).
# Useful for Vercel preview deployments and demos.
# Login: username=demo password=anything  MFA=any 6 digits
# CPA:   username=cpa.demo password=anything
VITE_DEMO_MODE=false
